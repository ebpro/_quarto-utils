```{=html}
<div class="gallery-header">
  <input type="search" class="gallery-search" placeholder="Rechercher..." aria-label="Rechercher">
  <span class="gallery-count" id="gallery-count"></span>
</div>
<div class="gallery-grid">
<% for (var i = 0; i < items.length; i++) { %>
<% var item = items[i]; %>
<% var isTP = item.path.indexOf('_P_') !== -1; %>
<article class="g-card <%= isTP ? 'g-card--tp' : 'g-card--cours' %>" data-title="<%= (item.title || item.path).toLowerCase().replace(/"/g, '&quot;') %>" data-desc="<%= (item.description || '').toLowerCase().replace(/"/g, '&quot;') %>">
  <div class="g-card__badge"><%= isTP ? 'TP' : 'COURS' %></div>
  <h3 class="g-card__title"><%- item.title || item.path %></h3>
  <% if (item.subtitle) { %><p class="g-card__subtitle"><%- item.subtitle %></p><% } %>
  <% if (item.description) { %><p class="g-card__desc"><%- item.description %></p><% } %>
  <div class="g-card__meta">
    <% if (item.date) { %><time><%- item.date %></time><% } %>
  </div>
  <div class="g-card__actions">
    <% if (item.provide_notes !== false) { %>
    <a href="<%= item.path.replace('.qmd', '.html') %>" class="g-btn g-btn--notes"><span>Notes</span></a>
    <% } %>
    <% if (item.provide_slides !== false && /\/[^/]*_L_[^/]*\.qmd$/.test(item.path)) { %>
    <a href="_slides<%= item.path.replace('.qmd', '.html') %>" class="g-btn g-btn--slides"><span>Slides</span></a>
    <% } %>
  </div>
  <% if (i < items.length - 1) { %>
  <% var next = items[i + 1]; %>
  <a href="<%= next.path.replace('.qmd', '.html') %>" class="g-card__next" title="Suivant">&rarr;</a>
  <% } %>
</article>
<% } %>
</div>
```
