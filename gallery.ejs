<%# Gallery — clean modern course index %>
<div class="gallery-header">
  <input type="search" class="gallery-search" placeholder="Rechercher…" aria-label="Rechercher dans le catalogue">
  <span class="gallery-count" id="gallery-count"></span>
</div>

<div class="gallery-grid" id="gallery-grid">
  <% let prevPath = null; %>
  <% for (const item of items) { %>
    <% const isPractice = item.path.includes('_P_'); %>
    <% const isLecture = item.path.includes('_L_'); %>
    <article class="g-card <%= isPractice ? 'g-card--tp' : 'g-card--cours' %>" 
             data-title="<%- item.title.toLowerCase() %>" 
             data-desc="<%- (item.description || '').toLowerCase() %>">
      <div class="g-card__badge"><%= isPractice ? '🧪 TP' : '📖 Cours' %></div>
      
      <h3 class="g-card__title"><%- item.title %></h3>
      <% if (item.subtitle) { %>
        <p class="g-card__subtitle"><%- item.subtitle %></p>
      <% } %>
      <% if (item.description) { %>
        <p class="g-card__desc"><%- item.description %></p>
      <% } %>
      
      <div class="g-card__meta">
        <% if (item['reading-time']) { %>
          <span class="g-card__time">≈ <%- item['reading-time'] %></span>
        <% } %>
        <% if (item.date) { %>
          <time><%- item.date %></time>
        <% } %>
      </div>
      
      <div class="g-card__actions">
        <% if (item.provide_notes !== false) { %>
          <a href="<%= item.path.replace('.qmd', '.html') %>" class="g-btn g-btn--notes">
            <span>Notes</span>
          </a>
        <% } %>
        <% if (item.provide_slides !== false) { %>
          <a href="_slides<%= item.path.replace('.qmd', '.html') %>" class="g-btn g-btn--slides">
            <span>Slides</span>
          </a>
        <% } %>
      </div>
      
      <% if (items.indexOf(item) < items.length - 1) { %>
        <% const next = items[items.indexOf(item) + 1]; %>
        <a href="<%= next.path.replace('.qmd', '.html') %>" class="g-card__next" title="Suivant: <%- next.title %>">
          →
        </a>
      <% } %>
    </article>
    <% prevPath = item.path; %>
  <% } %>
</div>

<% if (items.length === 0) { %>
<div class="gallery-empty">
  <p>Aucun contenu trouvé.</p>
</div>
<% } %>

<script>
(function() {
  const input = document.querySelector('.gallery-search');
  const cards = document.querySelectorAll('.g-card');
  const count = document.getElementById('gallery-count');
  
  if (count) count.textContent = cards.length + ' ' + (cards.length > 1 ? 'items' : 'item');
  
  if (!input) return;
  
  input.addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    let visible = 0;
    cards.forEach(function(card) {
      const title = card.dataset.title || '';
      const desc = card.dataset.desc || '';
      const match = !q || title.includes(q) || desc.includes(q);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (count) count.textContent = visible + ' ' + (visible > 1 ? 'items' : 'item');
  });
})();
</script>
