{
    // Path to the Docker Compose file relative to devcontainer.json	
    "dockerComposeFile": "../_quarto-utils/compose.yml",
    // digest: sha256:a96a060408efc7d0c08dcb80cd9456ddabacbd4590de4be06172dfa34875e618
  	
	// The 'service' property is the name of the service for the container that VS Code should
    // use. This is typically the main development container service	
    "service": "devcontainer",
	
	// Utile quand _quarto-utils est déjà matérialisé mais périmé (refresh du checkout avant build). NE SAUVE PAS le clone naïf: sans submodule initialisé, le symlink .devcontainer du repo consommateur est pendant et cette config n'est jamais lue — cloner avec `git clone --recurse-submodules` ou faire `git submodule update --init --recursive` d'abord (procédure documentée côté cours).
	"initializeCommand": "git -C ${localWorkspaceFolder} submodule update --init _quarto-utils",

	// The 'workspaceFolder' property is the path to the workspace folder in the container
	// that VS Code should use. This is typically the path to the workspace folder in the
	// container that the service is using
	"workspaceFolder": "/home/jovyan/work/local",

	// The 'shutdownAction' property defines what action to take when the container is stopped.
	"shutdownAction": "stopCompose",

	// N'évite que le service notebook-builder (commande cassée quarto-utils/_utils/build.sh — follow-up séparé). Le sidecar dind "docker" DÉMARRE QUAND MÊME : le service devcontainer hérite depends_on: docker (condition service_healthy) de x-common-config, et le CLI fait un `docker compose up -d devcontainer` sans --no-deps. Le rendre optionnel exigerait une restructuration de compose.yml (décision flotte).
	"runServices": ["devcontainer"],

	// Add VS Code extensions to install in container
    "customizations": {
        "vscode": {
            "extensions": [
                // Git extensions
                "donjayamanne.githistory",
                "eamodio.gitlens",
				"mhutchie.git-graph",
                
                // GitHub integration
                "GitHub.copilot",
                "github.vscode-github-actions",
                
                // Development tools
                "james-yu.latex-workshop",
                "jebbs.plantuml",
                "ms-azuretools.vscode-docker",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
               
                // Java development
                "GabrielBB.vscode-lombok",
                "vscjava.vscode-java-pack",
                
                // Database development
                "cweijan.vscode-database-client2",
                
                //Rest API development
                "rohinivsenthil.postcode",

                // Python development
                "ms-python.python",
                "ms-toolsai.jupyter",
                
				// Docker
				"ms-azuretools.vscode-docker",

				// Quarto
				"quarto.quarto",

				// C, C++
				"ms-vscode.cpptools-extension-pack",

                // Code quality and utils
                "redhat.vscode-xml",
                // "SonarSource.sonarlint-vscode",
                "vscode-icons-team.vscode-icons"
            ]
        }
    },

	// Le montage bind de ~/.ssh a été retiré (revue de conformité PR #54): via dockerComposeFile, le CLI devcontainers traduit mounts en volumes compose SANS honorer "readonly" (spec Mount: type/source/target uniquement) => ~/.ssh serait monté EN ÉCRITURE dans un conteneur root. VS Code Dev Containers forwardne nativement SSH_AUTH_SOCK (agent forwarding) vers le conteneur et le terminal intégré — c'est le mécanisme retenu pour git/gh dans le conteneur. Un montage statique de clés, s'il devient nécessaire, devra être exprimé dans compose.yml avec ":ro" (décision flotte séparée).

	// NOTE: compose service runs as root (user: root) while VS Code server runs as jovyan —
	// host-tree ownership friction is a known follow-up; see PR body.
	// The 'remoteUser' property is the user that VS Code should use when connecting to the container
	"remoteUser": "jovyan"
}

