/*-- scss:defaults --*/
// Colors
$primary-color: #0057B7;
$secondary-color: #6082B6;
$accent-color: #31BAE9;
$background-color: #FFFFFF;
$text-color: #2C3E50;
$link-color: $primary-color;

// Typography
$font-family-sans-serif: 'Manrope', sans-serif;
$font-family-monospace: 'Source Code Pro', monospace;
$presentation-heading-font: 'IBM Plex Serif', serif;
$presentation-font-size-root: 2em;
$presentation-line-height: 1.5;

// Presentation elements
$presentation-title-color: $primary-color;
$presentation-heading-color: $primary-color;
$presentation-h1-font-size: 2.5em;
$presentation-h2-font-size: 2em;
$presentation-h3-font-size: 1.5em;
$presentation-block-margin: 1.5rem;

// Code blocks
$code-block-bg: lighten($primary-color, 55%);
$code-block-border-left: 5px solid $accent-color;
$code-block-border-radius: 4px;
$code-block-font-size: 0.9em;
$code-font-size: 0.9em;
$code-color: darken($text-color, 10%);

/*-- scss:rules --*/
.reveal {
  .slide-number {
    font-size: 0.8em;
    background-color: rgba($primary-color, 0.1);
    padding: 0.2em 0.5em;
    border-radius: 3px;
  }

  .sourceCode {
    font-family: $font-family-monospace;
  }

  blockquote {
    border-left: 4px solid $accent-color;
    padding-left: 1em;
    font-style: italic;
  }

  table {
    border-collapse: collapse;
    th, td {
      border: 1px solid lighten($primary-color, 40%);
      padding: 0.5em;
    }
    th {
      background-color: rgba($primary-color, 0.1);
    }
  }

  .controls {
    color: $primary-color;
  }
}


// ...existing code...

// Cell theming for input / output (notebook cells + reveal slides)
$cell-input-bg: mix($background-color, #f2f8ff, 88%);   // pale input background
$cell-output-bg: #0b1220;                              // dark output for contrast
$cell-output-text: #e6f1ff;
$cell-border-color: rgba(0,0,0,0.06);
$cell-shadow: 0 6px 18px rgba(2,6,23,0.06);
$cell-padding: 0.6rem;

// Container styling for cells
.reveal .cell, .cell {
  border: 1px solid $cell-border-color;
  border-radius: 8px;
  padding: $cell-padding;
  margin: 0.6rem 0;
  box-shadow: $cell-shadow;
  overflow: auto;
  background: transparent; /* keep slide bg visible, individual blocks have explicit bg */
}

/* Code input (source code blocks) */
.reveal .sourceCode, .sourceCode, pre.sourceCode, pre.highlight {
  background: $cell-input-bg !important;
  color: $code-color !important;
  border-radius: 6px;
  padding: 0.65rem 0.9rem;
  font-family: $font-family-monospace;
  font-size: $code-font-size;
  line-height: 1.45;
  border-left: $code-block-border-left;
  box-shadow: inset 0 -1px 0 rgba(255,255,255,0.02);
  word-break: break-word;
  white-space: pre-wrap; /* wrap long lines */
}

/* Inline code contrast for readability */
.reveal p code, .reveal li code {
  background: darken($cell-input-bg, 5%);
  padding: 0.12rem 0.4rem;
  border-radius: 4px;
  color: $code-color;
}

/* Output blocks (stdout, images, tables, HTML output) */
.reveal .cell-output, .cell-output, .output_area, .cell-output-stdout, .cell-output-stderr {
  background: $cell-output-bg;
  color: $cell-output-text;
  border-radius: 6px;
  padding: 0.6rem;
  margin-top: 0.45rem;
  font-family: $font-family-monospace;
  font-size: calc(#{$code-font-size} * 0.98);
  line-height: 1.4;
}

/* Differentiate stderr with a subtle tint */
.reveal .cell-output-stderr {
  border-left: 4px solid #e87979; /* soft red */
  background: mix($cell-output-bg, #2b0a0a, 6%);
}

/* Tables inside outputs */
.reveal .cell-output table, .cell-output table {
  background: transparent;
  color: $cell-output-text;
}
.reveal .cell-output table th, .cell-output table td {
  border-color: rgba(255,255,255,0.06);
}

/* Make copy / line-numbers readable on dark output */
.reveal .copy-button, .reveal .linenodiv {
  z-index: 5;
  color: lighten($cell-output-text, 18%);
}

/* Small-screen adjustments */
@media (max-width: 720px) {
  .reveal .sourceCode, pre.sourceCode, pre.highlight {
    font-size: 0.85em;
    padding: 0.5rem;
  }
  .reveal .cell, .cell { padding: 0.45rem; }
}

// ...existing code...

// Label variables
$label-font-size: 0.75rem;
$label-padding: 0.18rem 0.5rem;
$label-radius: 999px;
$label-input-bg: $accent-color;
$label-input-color: #ffffff;
$label-output-bg: darken($cell-output-bg, 6%);
$label-output-color: $cell-output-text;
$label-z: 60;

/* Ensure code / output blocks can host absolutely positioned labels */
.reveal pre.sourceCode,
pre.sourceCode,
pre.highlight,
.reveal .cell-output,
.cell-output {
  position: relative;
}

/* Input badge on code cells */
.reveal pre.sourceCode::before,
pre.sourceCode::before,
pre.highlight::before {
  content: "Input";
  position: absolute;
  top: 0.45rem;
  right: 0.6rem;
  background: $label-input-bg;
  color: $label-input-color;
  padding: $label-padding;
  font-size: $label-font-size;
  border-radius: $label-radius;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  box-shadow: 0 4px 10px rgba(2,6,23,0.08);
  z-index: $label-z;
  pointer-events: none;
}

/* Output badge on output areas */
.reveal .cell-output::before,
.cell-output::before,
.reveal .output_area::before,
.output_area::before {
  content: "Output";
  position: absolute;
  top: 0.45rem;
  right: 0.6rem;
  background: $label-output-bg;
  color: $label-output-color;
  padding: $label-padding;
  font-size: $label-font-size;
  border-radius: $label-radius;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  box-shadow: 0 4px 10px rgba(2,6,23,0.06);
  z-index: $label-z;
  pointer-events: none;
}

/* Slightly different style for stderr outputs to call attention */
.reveal .cell-output-stderr::before,
.cell-output-stderr::before {
  content: "Error";
  background: #e87979;
  color: #fff;
}

/* Hide badges on very small screens to save space */
@media (max-width: 520px) {
  .reveal pre.sourceCode::before,
  pre.sourceCode::before,
  pre.highlight::before,
  .reveal .cell-output::before,
  .cell-output::before,
  .reveal .output_area::before,
  .output_area::before {
    display: none;
  }
}

// FOR NOTES

/* generic code-block targets used by Quarto/Highlight.js / Prism / Rouge */
$badge-top: 0.45rem;
$badge-right: 0.6rem;

/* ensure common code containers can host labels */
pre[class^="language-"],
code[class^="language-"],
.highlight pre,
.highlight code,
div.sourceCode pre,
pre.sourceCode,
pre.highlight,
.reveal pre.sourceCode,
.reveal pre.highlight,
.output_area,
div.output,
.cell-output {
  position: relative;
}

/* Input badge for common code-renderers */
pre[class^="language-"]::before,
.highlight pre::before,
div.sourceCode pre::before,
pre.sourceCode::before,
pre.highlight::before,
.reveal pre.sourceCode::before {
  content: "Input";
  position: absolute;
  top: $badge-top;
  right: $badge-right;
  background: $label-input-bg;
  color: $label-input-color;
  padding: $label-padding;
  font-size: $label-font-size;
  border-radius: $label-radius;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  box-shadow: 0 4px 10px rgba(2,6,23,0.08);
  z-index: $label-z;
  pointer-events: none;
}

/* Output badge for common output containers */
.output_area::before,
div.output::before,
.cell-output::before,
.reveal .cell-output::before,
.cell-output::before {
  content: "Output";
  position: absolute;
  top: $badge-top;
  right: $badge-right;
  background: $label-output-bg;
  color: $label-output-color;
  padding: $label-padding;
  font-size: $label-font-size;
  border-radius: $label-radius;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  box-shadow: 0 4px 10px rgba(2,6,23,0.06);
  z-index: $label-z;
  pointer-events: none;
}

/* stderr / error output */
div.output .stderr,
.cell-output-stderr,
.output_stderr,
.output_area .stderr {
  border-left: 4px solid #e87979;
}
div.output .stderr::before,
.cell-output-stderr::before {
  content: "Error";
  background: #e87979;
  color: #fff;
}

/* hide on very small screens */
@media (max-width: 520px) {
  pre[class^="language-"]::before,
  .highlight pre::before,
  pre.sourceCode::before,
  .output_area::before,
  div.output::before,
  .cell-output::before {
    display: none;
  }
}
